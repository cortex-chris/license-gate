#!/bin/sh
# license-gate global pre-push hook, for every repository on this machine.
# 1. Refuse the push if a commit being pushed declares a dependency under a
#    strong or network copyleft license (GPL, AGPL, SSPL) that the repository
#    has not recorded as a reviewed exception (.github/license-allowlist.json).
# 2. Then run the repository's own pre-push hook (Git LFS and the like).
# `git push --no-verify` skips both for one push.

refs=$(mktemp "${TMPDIR:-/tmp}/license-gate.XXXXXX") || exit 1
trap 'rm -f "$refs"' EXIT
cat > "$refs"

here=$(cd "$(dirname "$0")" && pwd -P)
gate="$here/../license_audit.py"
own_dir="$(git rev-parse --git-common-dir)/hooks"
[ "$(cd "$own_dir" 2>/dev/null && pwd -P)" = "$here" ] && own_dir=""   # never call ourselves
own="$own_dir/pre-push"

# A repository whose own hook already runs a license gate is not checked twice.
if [ -n "$own_dir" ] && [ -f "$own" ] && grep -q "license_audit" "$own"; then
    :
else
    py=""
    for candidate in python3.14 python3.13 python3.12 python3.11 python3; do
        if command -v "$candidate" >/dev/null 2>&1 &&
           "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
            py=$candidate
            break
        fi
    done
    if [ -z "$py" ]; then
        printf >&2 'license gate: needs Python 3.11 or newer; push refused\n'
        exit 1
    fi
    "$py" "$gate" --pre-push < "$refs" || exit 1
fi

if [ -n "$own_dir" ] && [ -x "$own" ]; then
    "$own" "$@" < "$refs" || exit $?
fi
exit 0
